# Copia este archivo como .env para correr la app en tu computador.
# En Hostinger estas mismas variables se cargan en el panel de la app Node.js.

# Primer administrador. Con base de datos se crea la primera vez que arranca la app; después los
# usuarios se manejan en la pantalla Usuarios y la contraseña se cambia en Mi cuenta.
# Sin base de datos es el único usuario que puede entrar.
APP_USER=rm
APP_PASSWORD=cambia-esta-clave

# Base de datos MySQL de Hostinger (hPanel > Bases de datos > MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

NODE_ENV=production
